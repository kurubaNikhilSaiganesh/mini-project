# ALTS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Admin ────────────────────────────────────────────────────
# PIN to access the admin data-management panel
# Change this before deployment
VITE_ADMIN_PIN=alts2026

# ─── App ──────────────────────────────────────────────────────
VITE_APP_NAME=ALTS
VITE_APP_TAGLINE=Campus Navigation & Student Platform

# ─── GitHub Pages (CI only) ───────────────────────────────────
# Set to 'true' in GitHub Actions deploy workflow only
# GITHUB_PAGES=true
